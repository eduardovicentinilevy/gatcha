{
  "name": "gatcha-api",
  "version": "0.1.0",
  "description": "API REST do Gatchá Cat Café: cardápio, gatos para adoção e painel da equipe",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "predev": "node scripts/preparar-dev.js --migrar",
    "dev": "node --watch --env-file=.env src/server.js",
    "preweb:dev": "node scripts/preparar-dev.js",
    "web:dev": "npm --prefix web run dev",
    "build": "npm run web:build",
    "web:build": "npm --prefix web run build",
    "db:up": "docker compose up -d --wait",
    "migrate": "node scripts/migrate.js",
    "premigrate:dev": "node scripts/preparar-dev.js",
    "migrate:dev": "node --env-file=.env scripts/migrate.js",
    "preadmin:criar": "node scripts/preparar-dev.js",
    "admin:criar": "node --env-file=.env scripts/criar-admin.js",
    "preadmin:2fa": "node scripts/preparar-dev.js",
    "admin:2fa": "node --env-file=.env scripts/admin-2fa.js",
    "prelgpd:exportar": "node scripts/preparar-dev.js",
    "lgpd:exportar": "node --env-file=.env scripts/titular.js exportar",
    "prelgpd:apagar": "node scripts/preparar-dev.js",
    "lgpd:apagar": "node --env-file=.env scripts/titular.js apagar",
    "prelgpd:expurgar": "node scripts/preparar-dev.js",
    "lgpd:expurgar": "node --env-file=.env scripts/expurgar-dados.js",
    "predev:popular": "node scripts/preparar-dev.js",
    "dev:popular": "node --env-file=.env scripts/popular-exemplo.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "postinstall": "node web/scripts/garantir-dependencias.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}

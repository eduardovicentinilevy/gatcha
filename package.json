{
  "name": "gatcha-api",
  "version": "0.1.0",
  "description": "API REST do Gatchá Cat Café: reservas do gatil, cardápio e adoção",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:dev": "node --env-file=.env scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}

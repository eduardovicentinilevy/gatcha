# Copie para .env (NUNCA versione o .env). Em produção, use o Secret Manager.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Banco ---
DATABASE_URL=postgres://gatcha:gatcha_dev@localhost:5433/gatcha   # = docker-compose.yml (porta 5433 no seu PC)
DB_SSL=false               # true em produção (Neon/Supabase/Cloud SQL)
DB_POOL_MAX=5              # instâncias máx. do Cloud Run x DB_POOL_MAX <= max_connections do banco
DB_STATEMENT_TIMEOUT_MS=10000

# --- HTTP ---
TRUST_PROXY=1              # Cloud Run direto = 1 ; Firebase Hosting -> Cloud Run = 2
CORS_ORIGINS=              # ex.: https://gatcha.com.br,https://www.gatcha.com.br (vazio se usar rewrite do Firebase)
RATE_LIMIT_PUBLICO_POR_MIN=120
RATE_LIMIT_RESERVAS_POR_15MIN=10
SERVIR_FRONTEND=true      # serve o build do React (web/dist) em http://localhost:8080

# --- Regras do gatil ---
# Dias e janelas: horário REAL da área dos gatos, informado no perfil do Gatchá
# (Seg à Sáb; 10h30-11h50 e 13h10-17h30). Confirmar na ligação. Capacidade e limites: PROVISÓRIOS.
TZ_NEGOCIO=America/Sao_Paulo
GATIL_CAPACIDADE=8                 # pessoas simultâneas no gatil
GATIL_DIAS=1,2,3,4,5,6             # 0=domingo ... 6=sábado
# Várias janelas separadas por vírgula. A agenda usa células de 15 min e arredonda para DENTRO
# (início p/ cima, fim p/ baixo): 10:30-11:50 vira 10:30-11:45 e 13:10-17:30 vira 13:15-17:30.
GATIL_JANELAS=10:30-11:50,13:10-17:30
RESERVA_MAX_PESSOAS=4              # por reserva (<= GATIL_CAPACIDADE)
RESERVA_ANTECEDENCIA_MAX_DIAS=14
RESERVA_MAX_ATIVAS_POR_CONTATO=3

# --- Avaliações do Google Maps (opcional; sem isso o site mostra avaliações de exemplo) ---
# Chave da "Places API (New)" (SEGREDO; restrinja a chave a essa API). Depois: npm run places:id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
AVALIACOES_CACHE_HORAS=6

# --- Painel administrativo (login) ---
# JWT_SECRET: SEGREDO, >= 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Vazio = login desativado. Em produção, venha do Secret Manager.
JWT_SECRET=
ADMIN_TOKEN_MINUTOS=15
RATE_LIMIT_LOGIN_POR_15MIN=10
LOGIN_MAX_FALHAS_POR_EMAIL=5          # falhas por e-mail + IP em 15 min
LOGIN_MAX_FALHAS_GLOBAL_POR_EMAIL=30  # falhas por e-mail somando todos os IPs (ataque distribuído)

# --- Retenção de dados pessoais (LGPD) ---
RETENCAO_RESERVAS_DIAS=90          # escopo: reservas com mais de 90 dias são apagadas
RETENCAO_INTERESSES_DIAS=180       # [CONFIRMAR] com o Gatchá
RETENCAO_ACESSOS_DIAS=90
